# OpenRouter — copy to repo root as .env
# https://openrouter.ai/keys

OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME

# semcod / pfix default
LLM_MODEL=openrouter/deepseek/deepseek-v4-pro

# aider reads this (not LLM_MODEL)
AIDER_MODEL=openrouter/deepseek/deepseek-v4-pro

# tillm readiness check for aider (maps OpenRouter → OpenAI slot)
OPENAI_API_KEY=${OPENROUTER_API_KEY}
